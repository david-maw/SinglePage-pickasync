<ContentPage x:Class="SinglePage.MainPage"
             xmlns:local="clr-namespace:SinglePage"
             x:DataType="local:MainPageViewModel"
             BindingContext="{local:MainPageViewModel}">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Margin="0,20,0,0"
                Aspect="AspectFit" />

            <Label
                Text="Hello, World!"
                Style="{StaticResource Headline}" />

            <Label
                Text="Welcome to &#10;.NET Multi-platform App UI"
                Style="{StaticResource SubHeadline}" />

            <Button
                Text="{Binding CounterText}"
                Command="{Binding IncrementCountCommand}"
                HorizontalOptions="Fill" />
            <Button
                Text="Browse"
                Command="{Binding BrowseCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
